<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aion.GameServer\Aion.GameServer.csproj" />
  </ItemGroup>

  <!-- Boot path (GameServerBootstrap → RiftService.InitRifts → RiftSchedule.Load) reads CWD-relative
       ./config/schedule/*.xml, faithful to Java. Deploy the schedule configs into the test output so the
       full-boot integration tests find them (mirrors a real GS deployment with config/ alongside the binary). -->
  <ItemGroup>
    <Content Include="..\..\game-server\config\schedule\*.xml" Link="config\schedule\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
