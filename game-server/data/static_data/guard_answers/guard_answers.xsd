<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="guard_answers">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="guard" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="answer" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="call" type="xs:int" use="required" />
                  <xs:attribute name="idle" type="xs:int" use="required" />
                  <xs:attribute name="busy" type="xs:int" use="required" />
                  <xs:attribute name="aims_at_sender" type="xs:boolean" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="npc_id" type="xs:int" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
