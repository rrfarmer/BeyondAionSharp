# CSHARP_REPOSITORY=C:/Users/ryanf/Documents/GitHub/BeyondAionSharp
# JAVA_REPOSITORY=C:/Users/ryanf/Documents/GitHub/aion-server

N8N_PORT_HOST=5678
GENERIC_TIMEZONE=America/New_York
