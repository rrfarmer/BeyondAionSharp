# ─────────────────────────────────────────────────────────────────────────────
#  Aion Server configuration — copy this file to ".env" and edit the values.
#  This is the ONLY file you need to touch.  After editing, run:  ./deploy.sh
# ─────────────────────────────────────────────────────────────────────────────

# The address players type into their game client to reach YOUR server.
#  - Same computer only:        127.0.0.1
#  - Other PCs on your network:  your LAN IP (e.g. 192.168.1.50)
#  - Public/Internet:            your public IP or domain name
# (The login server hands this out so clients know where the game server is.)
SERVER_HOST=127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the database. Pick anything; it stays inside Docker.
DB_PASSWORD=aion
# (advanced) database user — leave as root unless you know why you'd change it.
DB_USER=root

# ── Ports players/clients connect to (change only if something else uses them) ─
LOGIN_CLIENT_PORT=2106     # login server  (client login)
GAME_CLIENT_PORT=7777      # game server   (enter world)
CHAT_CLIENT_PORT=10241     # chat server   (in-game chat)

# ── Gameplay knobs (optional) ────────────────────────────────────────────────
# Mob respawn speed: 1.0 = normal, 0.5 = twice as fast, 2.0 = twice as slow.
RESPAWN_TIME_MULTIPLIER=1.0

# ── Web portal → game server admin bridge ────────────────────────────────────
# Shared secret the web portal presents to send mail through the LIVE game server
# (so online recipients get an instant bell + icon). Set the SAME value in the
# portal's environment (GAME_SERVER_ADMIN_TOKEN). Change this before sharing.
ADMIN_API_TOKEN=change-me-admin-token
